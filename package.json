  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "build": "pnpm typecheck && pnpm build:web",
    "build:web": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src/server scripts/lint",
    "lint:fix": "oxlint --fix src/server scripts/lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
