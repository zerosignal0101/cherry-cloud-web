# 监听地址；公网部署建议保持 127.0.0.1 并由反向代理转发
HOST=127.0.0.1
PORT=8787

# 数据目录：SQLite、附件、日志、密码哈希、会话密钥
DATA_DIR=./.data

# 数据库迁移目录，默认 ./migrations/sqlite-drizzle（随仓库提供，勿改）
# MIGRATIONS_DIR=

# 生产环境置为 production 时要求 dist/web 存在
NODE_ENV=development
LOG_LEVEL=info

# 首次启动的访问密码（至少 8 位）。仅在 DATA_DIR/auth.json 不存在时生效；
# 之后修改此变量不会改变密码，重置请删除 auth.json。
ADMIN_PASSWORD=

# 会话有效期（天），默认 30
# SESSION_TTL_DAYS=30

# 反向代理已终止 TLS 但未透传协议时，强制 Cookie 带 Secure
# COOKIE_SECURE=true

# 额外允许的来源（逗号分隔），开发时给 Vite 用
# ALLOWED_ORIGINS=http://localhost:5173

# 服务端密钥：用于加密供应商 API Key、备份凭据并派生会话签名密钥；
# 留空则自动生成 DATA_DIR/secret.key 与 DATA_DIR/session.key。
# 使用固定值时，恢复备份的服务器必须配置同一值才能解开备份中的凭据。
# APP_SECRET=

# 静态资源目录，默认 ./dist/web
# WEB_DIST=

# 服务端 Agent 浏览器使用的 Chrome/Chromium 路径；留空则使用 Playwright
# 内置解析（需安装与 playwright-core 匹配的 Chromium）。
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
