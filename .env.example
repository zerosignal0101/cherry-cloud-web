# 监听地址；公网部署建议保持 127.0.0.1 并由反向代理转发
HOST=127.0.0.1
PORT=8787

# 数据目录：SQLite、附件、日志、供应商目录快照
DATA_DIR=./.data

# 数据库迁移目录，默认 ./migrations/sqlite-drizzle（随仓库提供，勿改）
# MIGRATIONS_DIR=

# 生产环境置为 production 时要求 dist/web 存在
NODE_ENV=development
LOG_LEVEL=info

# 首次启动设置的管理员密码（M3 起生效）
# ADMIN_PASSWORD=

# 访问令牌：M1 阶段绑定非 loopback 地址时必须设置；M3 起由密码会话取代
# APP_TOKEN=

# 服务端密钥：用于加密供应商 API Key；留空则自动生成 DATA_DIR/secret.key
# APP_SECRET=

# 静态资源目录，默认 ./dist/web
# WEB_DIST=
